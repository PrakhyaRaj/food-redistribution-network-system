# Backend Environment Variables
# Copy this file to .env and fill in your personal values

# ===========================================
# REQUIRED: Database Configuration
# ===========================================
# PostgreSQL connection string
# For Docker: postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/frns_db
# For local PostgreSQL: postgresql+psycopg2://username:password@localhost:5432/frns_db
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/frns_db

# ===========================================
# REQUIRED: Security Configuration
# ===========================================
# Generate a secure random string for JWT tokens
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_JWT_SECRET_KEY_HERE

# ===========================================
# OPTIONAL: MongoDB Configuration
# ===========================================
# Leave empty or comment out if not using MongoDB
# For Docker: mongodb://root:YOUR_MONGO_PASSWORD@localhost:27017/frns_db?authSource=admin
MONGO_URI=mongodb://root:YOUR_MONGO_PASSWORD@localhost:27017/frns_db?authSource=admin
MONGO_DB=frns_db

# ===========================================
# OPTIONAL: Flask Configuration
# ===========================================
FLASK_ENV=development
FLASK_DEBUG=True

# ===========================================
# OPTIONAL: File Upload Configuration
# ===========================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# ===========================================
# OPTIONAL: CORS Configuration
# ===========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# NOTES
# ===========================================
# The values marked with "YOUR_..." need to be replaced with your actual values:
# - YOUR_POSTGRES_PASSWORD: Password for PostgreSQL database
# - YOUR_SECURE_RANDOM_JWT_SECRET_KEY_HERE: A long random string for JWT signing
# - YOUR_MONGO_PASSWORD: Password for MongoDB (if using MongoDB)