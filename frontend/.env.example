# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED: API Configuration
# ===========================================
# Backend API base URL
VITE_API_URL=http://127.0.0.1:5000

# Socket.IO server URL (usually same as API URL)
VITE_SOCKET_URL=http://127.0.0.1:5000

# ===========================================
# NOTES
# ===========================================
# - VITE_API_URL: The URL where your Flask backend is running
# - VITE_SOCKET_URL: The URL for Socket.IO connections (usually same as API URL)
#
# For production deployment, update these URLs to your production server URLs.